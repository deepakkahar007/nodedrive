# Version control, editor and OS files
.git
.gitignore
.agents
.idea
.vscode
**/.DS_Store

# Installed deps and build output. Rebuilt inside the image; macOS binaries break on Linux.
**/node_modules
**/.next
**/.turbo
**/out
**/dist
**/build
**/coverage
**/*.tsbuildinfo
**/*.log

# Secrets and private data. Pass credentials at runtime, never bake them in.
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.license
s3_storage

# Dev-only tooling and docs
docker-compose*.yml
**/Dockerfile*
**/.dockerignore
**/*.md
.npmrc

# The client app is not part of the server image. Keep only its manifest so the workspace graph still resolves.
apps/client/*
!apps/client/package.json
